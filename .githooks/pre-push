#!/bin/sh
# A branch name is pushed metadata too (SB-1421, docs/privacy.md). git feeds
# one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
root=$(git rev-parse --show-toplevel) || exit 1
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    for ref in "$local_ref" "$remote_ref"; do
        case "$ref" in
            refs/heads/*) name=${ref#refs/heads/} ;;
            refs/tags/*) name=${ref#refs/tags/} ;;
            *) continue ;;
        esac
        printf '%s\n' "$name" \
            | python3 "$root/scripts/privacy_scan.py" --text --label "ref $ref" || status=1
    done
done
exit $status
